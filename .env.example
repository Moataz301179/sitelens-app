# ===========================================================================
# Executive Team — CREDENTIALS / ACCESS CONFIG
# Copy to `.env` and fill in. EVERYTHING IS OPTIONAL. With nothing set, the
# system runs fully dry-run: it scans, plans, writes specs and reports, but
# touches no repo and pushes nothing. Each capability unlocks only when its
# variable is present.
# ===========================================================================

# ---- APPLY CHANNEL: let the team actually change code -----------------------
# Pick ONE transport (token is simplest). The agent opens a dedicated fix
# branch + commits + opens a PR. It never force-pushes main or deletes.

# Option A — GitHub token (HTTPS REST API). No local clone needed.
#   Classic PAT scope: repo
#   Fine-grained PAT: Contents (write) + Pull requests (write)
GITHUB_TOKEN=
GITHUB_REPO=owner/site-source-repo      # REQUIRED for any apply
GITHUB_BASE_BRANCH=main
GITHUB_BRANCH_PREFIX=fix/exec-team

# Option B — SSH key (git push from a local clone).
# Provide a private key (ed25519/rsa) AND a local clone path.
# PR still opened via GITHUB_TOKEN if also set; otherwise you open it.
GITHUB_SSH_KEY=                         # raw key OR path to key file
REPO_LOCAL_PATH=                        # absolute path to a local clone

# Explicit opt-in to apply. Never implied. Set to "true" to allow code changes.
APPLY_ENABLED=false

# ---- CODE GENERATION (real diffs, not just specs) --------------------------
# Without this the agent emits remediation SPECS (markdown). With it, an LLM
# drafts actual code patches mapped to your repo's files.
OPENROUTER_API_KEY=
# Optional: which model the Software Engineer agent uses for code drafting.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- PERFORMANCE MEASUREMENT (before/after scoring) ------------------------
# Optional. Raises PageSpeed Insights quota for more reliable perf scores.
PAGESPEED_API_KEY=

# ---- LIVE OUTWARD ACTIONS (unchanged from before) --------------------------
# Social posting
AGENT_REACH_POST_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MCP_URL=
TWITTER_API_KEY=

# Meta Ads edits (dry-run unless BOTH set; live edits are hard to undo)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Image / video generation
IMAGE_GEN_API_KEY=
VIDEO_GEN_API_KEY=

# ---- DATABASE (optional, for persistent metric history) --------------------
DATABASE_URL=

# ---- ENGINE (optional) ----------------------------------------------------
EXECUTIVE_ENGINE_AUTOSTART=false
# If set, the 24/7 loop targets the live audit of this URL (so decisions are
# grounded in your real site) instead of the synthetic seed business.
EXECUTIVE_TARGET_URL=
